# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
dist
dist-ssr
*.local

# Environment variables — *.local above already covers .env.local, but a
# plain .env (no .local suffix) wouldn't be, so this is explicit belt-and-suspenders.
.env
.env.*
!.env.example

# Test output
playwright-report
test-results
coverage
.playwright-mcp

# Installed Claude Code skills — restore with `npx skills experimental_install`,
# which reads skills-lock.json (that file IS tracked).
.agents
.claude/skills

# Scratch output from local dev/test runs (root level only, so public/images is untouched)
*.err
/*.png

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
